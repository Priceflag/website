{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    { "source": "/about",   "destination": "/about.html" },
    { "source": "/legal",   "destination": "/legal.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/how-we-measure", "destination": "/how-we-measure.html" },
    { "source": "/vs-intelligems", "destination": "/vs-intelligems.html" },
    { "source": "/black-friday", "destination": "/black-friday.html" }
  ],

  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "signin.priceflag.org" }],
      "destination": "https://dashboard.priceflag.org/signin",
      "permanent": true
    },
    { "source": "/signin.html", "destination": "https://dashboard.priceflag.org/signin", "permanent": true }
  ],

  "headers": [
    {
      "source": "/signin.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; img-src 'self' https://priceflag.org data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'unsafe-inline'; connect-src https://dashboard.priceflag.org; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
